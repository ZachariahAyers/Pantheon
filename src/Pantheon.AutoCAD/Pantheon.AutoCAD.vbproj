<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AutoCAD 2027 loads .NET 10 add-ins (Autodesk AutoCAD 2027 SDK notes). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pantheon.AutoCAD</RootNamespace>
    <AssemblyName>Pantheon</AssemblyName>
    <MyType>Empty</MyType>
    <!-- Lets the add-in compile on Linux and macOS; only AutoCAD on Windows runs it. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD supplies these assemblies at run time; compile against them only. -->
    <PackageReference Include="AutoCAD.NET" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pantheon.Core\Pantheon.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.bmp;Icons\*.png" LogicalName="Pantheon.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- A Release build also lays out the Autodesk App Store bundle beside the add-in. -->
  <Target Name="AssembleBundle" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <BundleDir>$(OutDir)Pantheon.bundle/</BundleDir>
    </PropertyGroup>
    <ItemGroup>
      <BundleAssembly Include="$(OutDir)*.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(BundleDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)PackageContents.xml" DestinationFolder="$(BundleDir)" />
    <Copy SourceFiles="@(BundleAssembly)" DestinationFolder="$(BundleDir)Contents/net10.0-windows/" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Help/Pantheon.html" DestinationFolder="$(BundleDir)Contents/Help" />
    <ZipDirectory SourceDirectory="$(BundleDir)" DestinationFile="$(OutDir)Pantheon.bundle.zip" Overwrite="true" />
  </Target>

</Project>
